/*
This is example menu definition file for Q2PRO.

File format is line based, whitespace is ignored.  C and C++ style comments are
supported.  Long lines can be broken into multiple ones by escaping linefeed
characters with backslashes.

Lines are macro expanded at script load time just as usual console commands.
Any cvars and macros can be referenced.

Maximum line length after expansion is limited to 1024 chars (this is Q2
command line parser limitation). Menu items of spin control type (‘values’ and
‘strings’) support special hack that avoids 1024 chars limit by performing
expansion after command line is parsed: prefix cvar name to be expanded with
"$$" instead of "$".

Duplicate menu entries override previous ones.  Built-in menus (‘demos’,
‘servers’ and ‘players’) can not be overridden.  When user presses ESC while
disconnected, ‘main’ menu is pushed.  When user presses ESC while spawned in
game, ‘game’ menu is pushed if it is found, otherwise ‘main’ menu is pushed.

Supported keywords and their syntax:

include <filename>

background <color|image>
font <image>
cursor <image>
weapon <model>

color <state> <color>

begin <menuname>
   title <menutitle>
   banner <image>
   background <color|image>
   plaque <plaque> [logo]

   range <name> <cvar> <min> <max> [step]

   pairs <name> <cvar> <string1> <value1> [...]
   values <name> <cvar> <string1> [...]
   strings <name> <cvar> <value1> [...]
   toggle <name> <cvar> [~][bit]

   bind <name> <command>
   action <name> <command>
   bitmap <image> <command>
   savegame <slot>
   loadgame <slot>
   blank

   field [options] <name> <cvar>
end
*/

background black
font conchars
cursor ch1
weapon w_railgun.md2

color normal #0f90eb64
color active #0f90ff64
color selection #0f90eb64
color disabled #7f7f7f

begin video
    //title "Video Setup"
    banner m_banner_video
    pairs --status "Vulkan is optional and needs a Vulkan driver. OpenGL is the default" \
        "renderer" vid_ref "OpenGL" gl "Vulkan" vk
    pairs --status "GPU for the Vulkan renderer. Automatic prefers the GPU that drives the display" \
        "Vulkan device" vk_device $$vk_devicelist
    action --align --status "Ray-traced lighting, reflections and effects. Vulkan only, needs ray query support" \
        "Vulkan ray tracing..." pushmenu raytracing
    values --status "Windowed, or a fullscreen mode from the list of video modes" \
        "video mode" vid_fullscreen windowed $$vid_modelist
    field --status "Horizontal field of view in degrees. The default is 90" \
        --numeric --width 4 "field of view" fov
    values --status "On wide screens, vert- keeps the 4:3 view and crops it, hor+ shows more at the sides" \
        "fov scaling" cl_adjustfov vert- hor+
    toggle --status "Match frames to the monitor refresh rate to stop tearing. Can add input lag" \
        "vertical sync" gl_swapinterval
    pairs --status "Vulkan only. Automatic follows vertical sync; mailbox avoids tearing with less lag than FIFO" \
        "Vulkan present mode" vk_present_mode automatic 0 FIFO 1 mailbox 2 immediate 3
    pairs --status "Smooth jagged edges with multisampling, at a cost in speed" \
        "anti-aliasing" gl_multisamples no 0 "2x MSAA" 2 "4x MSAA" 4 "8x MSAA" 8
    range --status "Brightness of the picture. Applies to textures only, unless hardware gamma is on" \
        "texture gamma" vid_gamma 1.3 0.3
    toggle --status "Apply gamma to the whole screen through the video driver instead of to textures" \
        "hardware gamma" vid_hwgamma
    range --status "Lower quality reduces texture resolution to save video memory" \
        "texture quality" gl_picmip 3 0 -1
    pairs --status "How textures are smoothed: nearest looks pixelated, trilinear is the smoothest" \
        "texture filter" gl_texturemode \
        nearest GL_NEAREST \
        linear GL_LINEAR \
        bilinear GL_LINEAR_MIPMAP_NEAREST \
        trilinear GL_LINEAR_MIPMAP_LINEAR
    pairs --status "Keeps textures sharp on surfaces seen at a steep angle, such as floors" \
        "anisotropic filter" gl_anisotropy no 1 2x 2 4x 4 8x 8 16x 16
    range --status "Color strength of world textures. 0 makes them gray" \
        "texture saturation" gl_saturation 0 1
    pairs --status "Brightens textures. The default is 2x" \
        "texture intensity" intensity 1x 1 2x 2 3x 3
    range --status "Brightness of the HUD, menus and console" \
        "2D intensity" gl_intensity_2D 1 5 0.1
    values --status "Glowing lava, for textures that have glowmaps. All also covers lava without a lightmap" \
        "lava glowmaps" r_lava_glowmaps "off" "with lightmap" "all"
    range --status "Brightness of glowmaps, the glowing parts of textures and models" \
        "glowmap intensity" gl_glowmap_intensity 0 1 0.05
    range --status "Color strength of world lighting. 0 makes the lighting gray" \
        "lightmap saturation" gl_coloredlightmaps 0 1
    range --status "Adds light to the whole level, making dark areas lighter" \
        "lightmap brightness" gl_brightness 0 0.3
    values --status "Shaders needs OpenGL 3.0 and is required for bloom, skin tints and screen warping" \
        "rendering backend" gl_shaders legacy shaders
    toggle --status "Off draws the sky in solid black" \
        "draw sky" gl_drawsky
    toggle --status "Show flying body parts. Off also saves bandwidth on Q2PRO servers" \
        "gibs" cl_gibs
    range --status "Brightens the lighting of the level and of models" \
        "modulate" gl_modulate 1 5
    range --status "Brightens the lighting of the level only" \
        "modulate world" gl_modulate_world 1 5
    range --status "Brightens the lighting of models only, such as players and items" \
        "modulate entities" gl_modulate_entities 1 5
end

begin raytracing
    title "Ray Tracing Setup"
    toggle --status "Enable Vulkan ray tracing; changing this refreshes the renderer" \
        "ray tracing" vk_raytracing
    toggle --status "Allow bright ray-traced effects and lamps to contribute bloom" \
        "bloom" gl_bloom
    blank
    action --align "lighting..." pushmenu rt_lighting
    action --align "reflections and materials..." pushmenu rt_materials
    action --align "liquids and atmosphere..." pushmenu rt_atmosphere
    action --align "particle effects..." pushmenu rt_particles
end

begin rt_lighting
    title "Ray-Traced Lighting"
    range --status "Contact shadowing in corners and at surface junctions" \
        "ambient occlusion" vk_rt_ao 0 0.5 0.01
    range --status "Colored lighting from glowing world surfaces" \
        "emissive lighting" vk_rt_emissive 0 2 0.05
    range --status "Cool ambient fill on surfaces open to the sky" \
        "sky light" vk_rt_skylight 0 1 0.05
    range --status "Warm light from above on surfaces open to the sky" \
        "sunlight" vk_rt_sunlight 0 1 0.05
    range --status "Colored light spilling from explosions and projectiles" \
        "dynamic color bounce" vk_rt_bounce 0 1 0.05
    range --status "Colored edges on soft shadows of nearby dynamic lights" \
        "shadow fringes" vk_rt_shadow_fringe 0 1 0.05
    range --status "Animated rings of light around strong dynamic lights" \
        "dynamic light ripples" vk_rt_light_ripples 0 1 0.05
    range --status "Fade time in seconds for bright short-lived lights" \
        "dynamic light afterglow" vk_rt_afterglow 0 1 0.05
    range --status "Colored glow around the edges of glowing surfaces" \
        "emissive edge halos" vk_rt_emissive_halo 0 1 0.05
    range --status "Irregular flicker of lamps, their halos and their bloom" \
        "lamp flicker" vk_rt_emissive_flicker 0 1 0.05
end

begin rt_materials
    title "Ray-Traced Reflections"
    range --status "Screen-space reflections on floors and grazing walls. Needs MSAA off" \
        "reflections" vk_rt_reflections 0 1 0.05
    range --status "Small colored highlights around bright reflected things" \
        "reflection glints" vk_rt_reflection_glints 0 1 0.05
    range --status "Red and blue fringes around bright details in smooth reflections" \
        "reflection dispersion" vk_rt_reflection_dispersion 0 1 0.05
    range --status "Highlights from dynamic lights and glowing surfaces" \
        "specular highlights" vk_rt_specular 0 1 0.05
    range --status "Cool sheen on reflective materials" \
        "environment sheen" vk_rt_environment 0 1 0.05
end

begin rt_atmosphere
    title "Ray-Traced Liquids and Atmosphere"
    range --status "Ripples, sheen and highlights on water, slime and lava" \
        "liquid effects" vk_rt_liquids 0 1 0.05
    range --status "Animated light on nearby surfaces while under water" \
        "underwater caustics" vk_rt_caustics 0 1 0.05
    range --status "Blue-green fading with distance while under water" \
        "underwater absorption" vk_rt_underwater_absorption 0 1 0.05
    range --status "Blue-gray haze with distance" \
        "atmospheric haze" vk_rt_atmosphere 0 1 0.05
    range --status "Strong dynamic lights glow inside fog" \
        "light scattering" vk_rt_light_scattering 0 1 0.05
    range --status "Slowly moving density in fog" \
        "fog turbulence" vk_rt_fog_turbulence 0 1 0.05
    range --status "Drifting dust motes near the viewer" \
        "ambient dust" vk_rt_dust 0 1 0.05
    range --status "How strongly nearby dynamic lights color the dust" \
        "dust lighting" vk_rt_dust_lighting 0 1 0.05
end

begin rt_particles
    title "Ray-Traced Particle Effects"
    range --status "Faint energy motes around glowing surfaces" \
        "emissive motes" vk_rt_emissive_motes 0 1 0.05
    range --status "Embers rising from lava" \
        "lava embers" vk_rt_lava_embers 0 1 0.05
    range --status "Halos around strong combat lights" \
        "light coronas" vk_rt_light_coronas 0 1 0.05
    range --status "Expanding rings around explosions" \
        "shockwaves" vk_rt_shockwaves 0 1 0.05
    range --status "Short-lived marks where shots hit" \
        "impact marks" vk_rt_impact_marks 0 1 0.05
    range --status "Ionization pulse where rails land, in the trail's colors" \
        "rail impact" vk_rt_rail_impact 0 1 0.05
    range --status "Sparks for electric impacts" \
        "electric filaments" vk_rt_electric_filaments 0 1 0.05
    range --status "Rings on water, slime and lava splashes" \
        "splash ripples" vk_rt_splash_ripples 0 1 0.05
    range --status "Wakes behind players moving through water" \
        "water wakes" vk_rt_water_wakes 0 1 0.05
    range --status "A vortex at teleports" \
        "teleport vortex" vk_rt_teleport_vortex 0 1 0.05
    range --status "A glow where items respawn" \
        "item respawn" vk_rt_item_respawn 0 1 0.05
    range --status "Dust when players land after a fall" \
        "landing dust" vk_rt_landing_dust 0 1 0.05
    range --status "A collapse effect where BFG and tracker shots hit" \
        "energy collapse" vk_rt_energy_collapse 0 1 0.05
end

begin options
    //title "Options"
    banner m_banner_options
    action "player setup" pushmenu players
    action "input setup" pushmenu input
    action "key bindings" pushmenu keys
    action "weapon bindings" pushmenu weapons
    action "video setup" pushmenu video
    action "sound setup" pushmenu sound
    action "effects setup" pushmenu effects
    action "screen setup" pushmenu screen
    action "download options" pushmenu downloads
    action "address book" pushmenu addressbook
end

begin sound
    title "Sound Setup"
    values --status "OpenAL adds positional 3D sound, HRTF and reverb. Software is the classic mixer" \
        "sound engine" s_enable "no sound" "software" "OpenAL"
    range --status "Raise it if sound stutters or crackles. Software engine only" \
        "sound latency" s_mixahead 0.05 0.2
    range --status "Volume of all game sounds" \
        "sound volume" s_volume 0 1
    range --status "Music volume, relative to the sound volume" \
        "music volume" ogg_volume 0 1
    toggle --status "Play background music from the music directory" \
        "enable music" ogg_enable
    toggle --status "Play all music tracks in random order instead of the track the map asks for" \
        "shuffle tracks" ogg_shuffle
    toggle --status "Muffle sounds while you are under water" \
        "underwater effect" s_underwater
    values --status "3D sound for headphones. OpenAL engine only. Default follows the OpenAL setting" \
        "HRTF mixing" al_hrtf "off" "default" "on"
    pairs --status "Room echo on positional sounds. OpenAL engine only" \
        "reverb" al_reverb "off" 0 "light" 1 "strong" 2
    values --status "Background sounds such as machinery. The last two keep only sounds from what you see or from you" \
        "ambient sounds" s_ambient "no" "yes" "visible entities" "player's own"
    values --status "Sound played when a chat message arrives" \
        "chat beep" cl_chat_sound "disabled" "default" "alternative"
end

begin railtrail
    title "Railgun Trail Setup"
    values --status "Default is the original effect. The others draw a solid core, optionally with a spiral" \
        "rail trail type" cl_railtrail_type \
        "default" "core only" "core and spiral"
    range --status "How long the trail stays visible, in seconds" \
        "rail trail duration" cl_railtrail_time 0.1 3.0 0.1
    range --status "Width of the solid core" \
        "core width" cl_railcore_width 1 6 1
    range --status "Soft glow around the core, with a paler center. 0 is a plain core" \
        "core glow" cl_railcore_glow 0 1 0.05
    range --status "Radius of the spiral" \
        "spiral radius" cl_railspiral_radius 1 6 1
    strings --status "Color of the solid core" \
        "core color" cl_railcore_color \
        black red green yellow blue cyan magenta white
    strings --status "Color of the spiral" \
        "spiral color" cl_railspiral_color \
        black red green yellow blue cyan magenta white
end

begin effects
    title "Effects Setup"
    values --status "Light from explosions, rockets and muzzle flashes. Only switchable keeps map lights that turn on and off" \
        "dynamic lighting" gl_dynamic "no" "yes" "only switchable"
    values --status "Draw black outlines around models" \
        "entity cel-shading" gl_celshading no 1x 2x 3x
    toggle --status "Pulsing glow around items such as ammo, health and armor" \
        "entity glowing" cl_noglow ~
    toggle --status "Recolor item skins instead of drawing a shell. Shaders backend only" \
        "tint item skins" cl_itemtint
    toggle --status "Recolor weapon skins, including your own view weapon. Shaders backend only" \
        "tint weapon skins" cl_weapontint
    toggle --status "Recolor ammo skins. Shaders backend only" \
        "tint ammo skins" cl_ammotint
    toggle --status "Recolor player skins: male white, female green, other models amber. Shaders backend only" \
        "tint player skins" cl_playertint
    toggle --status "Colored shell around health, armor and powerups" \
        "item highlighting" cl_itemhighlight
    toggle --status "Colored shell around weapon pickups and weapons held by players" \
        "weapon highlighting" cl_weaponhighlight
    toggle --status "Colored shell around ammo, in the color of its weapon" \
        "ammo highlighting" cl_ammohighlight
    toggle --status "Colored shell around players: male white, female green, other models orange" \
        "player highlighting" cl_playerhighlight
    toggle --status "Glow around glowmaps and glowing highlights (shaders backend)" \
        "bloom" gl_bloom
    range --status "Glow strength of highlights. Needs bloom. 0 keeps a plain shell" \
        "highlight bloom" cl_itemhighlight_glow 0 5 1
    values --status "Shadows under models. Fade makes them lighter with distance" \
        "ground shadows" gl_shadows no yes fade
    toggle --status "Color the screen when you are hit, pick up items or are under water" \
        "screen blending" gl_polyblend
    toggle --status "Wavy screen while under water. Shaders backend only" \
        "screen warping" gl_waterwarp
    toggle --status "Show the explosion model for grenades. Off keeps only particles" \
        "grenade explosions" cl_disable_explosions ~0
    toggle --status "Show the explosion model for rockets. Off keeps only particles" \
        "rocket explosions" cl_disable_explosions ~1
    toggle --status "Hide blood particles only for impacts on your player" \
        "blood particles when hit" cl_disable_self_blood ~
    strings --status "Particle color of rocket and grenade trails. None keeps the original colors" \
        "rocket and grenade trails" cl_projectiletrail_color \
        none red green yellow blue cyan magenta white
    blank
    action --align "railgun trail setup..." pushmenu railtrail
end

begin crosshair
    title "Crosshair Setup"
    values --status "Crosshair image" \
        "crosshair type" crosshair none cross dot angle
    pairs --status "Crosshair size" \
        "crosshair scale" ch_scale 0.5x 0.5 1x 1 2x 2 4x 4 5x 5
    toggle --status "Color the crosshair by your health. Overrides the color settings below" \
        "color by health" ch_health
    range --status "Crosshair color. Ignored when coloring by health" \
        "red channel" ch_red 0 1
    range --status "Crosshair color. Ignored when coloring by health" \
        "green channel" ch_green 0 1
    range --status "Crosshair color. Ignored when coloring by health" \
        "blue channel" ch_blue 0 1
    range --status "Crosshair opacity" \
        "alpha channel" ch_alpha 0 1
end

begin screen
    title "Screen Setup"
    range --status "Size of the 3D view. Smaller sizes add a border" \
        "screen size" viewsize 40 100 10
    toggle --status "Small graph of your network latency" \
        "ping graph" scr_lag_draw
    values --status "Progress bar during demo playback. Verbose also shows the time" \
        "demo bar" scr_demobar no yes verbose
    range --status "Opacity of the HUD" \
        "HUD opacity" scr_alpha 0 1
    range --status "Opacity of the console background" \
        "console opacity" con_alpha 0 1
    pairs --status "Size of the HUD. Auto picks a size for the screen resolution" \
        "HUD scale" scr_scale auto 0 1x 1 2x 2 4x 4 5x 5
    pairs --status "Size of the console text. Auto picks a size for the screen resolution" \
        "console scale" con_scale auto 0 1x 1 2x 2 4x 4 5x 5
    pairs --status "Size of the menus. Auto picks a size for the screen resolution" \
        "menu scale" ui_scale auto 0 1x 1 2x 2 4x 4 5x 5
    blank
    action --align "crosshair setup..." pushmenu crosshair
end

begin downloads
    title "Download Options"
    toggle --status "Download missing files from servers. The options below choose which" \
        "allow downloading" allow_download
    toggle --status "Download missing maps" \
        "maps" allow_download_maps
    toggle --status "Download missing player models, skins and sounds" \
        "player models/skins" allow_download_players
    toggle --status "Download missing item and effect models" \
        "models" allow_download_models
    toggle --status "Download missing sounds" \
        "sounds" allow_download_sounds
    toggle --status "Download missing map textures" \
        "textures" allow_download_textures
    toggle --status "Download missing HUD pictures" \
        "pics" allow_download_pics
    blank
    toggle --status "Use the faster HTTP download server when the game server offers one" \
        "HTTP downloads" cl_http_downloads
end

begin gameflags
    title "Deathmatch Flags"
    toggle --status "Players take damage from long falls" \
        "falling damage" dmflags ~3
    toggle --status "Weapons stay in place after being picked up" \
        "weapons stay" dmflags 2
    toggle --status "Powerups are used on pickup instead of going to the inventory" \
        "instant powerups" dmflags 4
    toggle --status "Powerups such as quad damage appear on the map" \
        "allow powerups" dmflags ~1
    toggle --status "Health items appear on the map" \
        "allow health" dmflags ~0
    toggle --status "Armor appears on the map" \
        "allow armor" dmflags ~11
    toggle --status "Players respawn at the spawn point farthest from others" \
        "spawn farthest" dmflags 9
    toggle --status "Play the same map again instead of moving to the next one" \
        "same map" dmflags 5
    toggle --status "Dead players respawn automatically" \
        "force respawn" dmflags 10
    toggle --status "Weapons never run out of ammo" \
        "infinite ammo" dmflags 13
    toggle --status "Every player sees with a 90 degree field of view" \
        "fixed FOV" dmflags 15
    toggle --status "A player killed with quad damage drops it" \
        "quad drop" dmflags 14
end

begin startserver
    //title "Start Server"
    banner m_banner_start_server
    strings --status "The first map of the server" \
        "initial map" _ui_nextserver $$com_maplist
    values --status "Deathmatch or cooperative play" \
        "rules" coop deathmatch cooperative
    field --status "Minutes until the map ends. 0 for no limit" \
        --integer --width 3 "time limit" timelimit
    field --status "Frags that end the map. 0 for no limit" \
        --integer --width 3 "frag limit" fraglimit
    field --status "Most players at once, including you" \
        --integer --width 3 "max players" maxclients
    field --status "Server name shown in server browsers" \
        --width 16 "host name" hostname
    blank
    action --align "deathmatch flags..." pushmenu gameflags
    action --align "begin game!" "forcemenuoff; if $coop == 1 then deathmatch 0 else deathmatch 1; map $_ui_nextserver force"
end

begin multiplayer
    banner m_banner_multiplayer
    action "browse q2servers.com" pushmenu servers "+http://q2servers.com/?raw=2"
    action "browse address book" pushmenu servers "favorites://" "file:///servers.lst" "broadcast://"
    action "browse demos" pushmenu demos
    action "start server" pushmenu startserver
end

begin singleplayer
    banner m_banner_game
    action easy "skill 0; deathmatch 0; coop 0; maxclients 1; newgame"
    action medium "skill 1; deathmatch 0; coop 0; maxclients 1; newgame"
    action hard "skill 2; deathmatch 0; coop 0; maxclients 1; newgame"
    action nightmare "skill 3; deathmatch 0; coop 0; maxclients 1; newgame"
    blank
    action "load game..." pushmenu loadgame
    action "save game..." pushmenu savegame
end

begin loadgame
    banner m_banner_load_game
    loadgame save0
    blank
    loadgame save1
    loadgame save2
    loadgame save3
    loadgame save4
    loadgame save5
    loadgame save6
    loadgame save7
    loadgame save8
    loadgame save9
    loadgame save10
    loadgame save11
    loadgame save12
    loadgame save13
    loadgame save14
    loadgame save15
end

begin savegame
    banner m_banner_save_game
    savegame save1
    savegame save2
    savegame save3
    savegame save4
    savegame save5
    savegame save6
    savegame save7
    savegame save8
    savegame save9
    savegame save10
    savegame save11
    savegame save12
    savegame save13
    savegame save14
    savegame save15
end

begin main
    //title "Main Menu"
    plaque m_main_plaque m_main_logo
    bitmap m_main_game pushmenu singleplayer
    bitmap m_main_multiplayer pushmenu multiplayer
    bitmap m_main_options pushmenu options
    bitmap m_main_video pushmenu video
    bitmap m_main_quit quit
end

begin game
    background #0000ff20
    style --compact
    action "browse q2servers.com" pushmenu servers "+http://q2servers.com/?raw=2"
    action "browse address book" pushmenu servers "favorites://" "file:///servers.lst" "broadcast://"
    action "browse demos" pushmenu demos
    action "single player" pushmenu singleplayer
    action "options" pushmenu options
    action "disconnect" disconnect
    action "quit" quit
end

begin addressbook
    //title "Address Book"
    banner m_banner_addressbook
    field --width 32 --center adr0
    field --width 32 --center adr1
    field --width 32 --center adr2
    field --width 32 --center adr3
    field --width 32 --center adr4
    field --width 32 --center adr5
    field --width 32 --center adr6
    field --width 32 --center adr7
    field --width 32 --center adr8
    field --width 32 --center adr9
    field --width 32 --center adr10
    field --width 32 --center adr11
    field --width 32 --center adr12
    field --width 32 --center adr13
    field --width 32 --center adr14
    field --width 32 --center adr15
end

begin input
    title "Input Setup"
    field --status "Mouse sensitivity" \
        --numeric --width 8 "mouse sens" sensitivity
    toggle --status "Lower the sensitivity when the field of view narrows, such as when zooming" \
        "auto sens" m_autosens
    toggle --status "Smooth mouse movement by averaging it over two frames" \
        "mouse filter" m_filter
    toggle --status "R1Q2 mouse handling: no acceleration and no automatic sensitivity scaling" \
        "R1Q2 mouse" m_r1q2_mouse
    toggle --status "Look up and down with the mouse at all times" \
        "free look" freelook
    toggle --status "Run by default. Hold the run key to walk" \
        "always run" cl_run
    pairs --status "R1Q2 predicts only completed moves, as R1Q2 does. Changes feel only, not physics" \
        "movement feel" cl_movement_feel_mode Q2PRO 0 R1Q2 1
    pairs --status "How the view smooths stairs: Q2PRO, or one of the three R1Q2 modes. Visual only" \
        "step smoothing" cl_step_smoothing_mode Q2PRO q2pro R1Q2-1 r1q2-1 R1Q2-2 r1q2-2 R1Q2-3 r1q2-3
end

begin keys
    title "Key Bindings"
    bind "attack" +attack
    bind "next weapon" weapnext
    bind "previous weapon" weapprev
    bind "walk forward" +forward
    bind "backpedal" +back
    bind "run" +speed
    bind "step left" +moveleft
    bind "step right" +moveright
    bind "up / jump" +moveup
    bind "down / crouch" +movedown
    bind "inventory" inven
    bind "use item" invuse
    bind "drop item" invdrop
    bind "prev item" invprev
    bind "next item" invnext
    bind "help computer" help
    bind "pause game" pause
    bind "scoreboard" score
    bind "chat" messagemode
    blank
    action --align "legacy keys..." pushmenu legacykeys
end

begin legacykeys
    title "Legacy Key Bindings"
    bind "turn left" +left
    bind "turn right" +right
    bind "sidestep" +strafe
    bind "look up" +lookup
    bind "look down" +lookdown
    bind "center view" centerview
    bind "mouse look" +mlook
    bind "keyboard look" +klook
end

begin weapons
    title "Weapon Bindings"
    bind "blaster" "use Blaster"
    bind "shotgun" "use Shotgun"
    bind "super shotgun" "use Super Shotgun"
    bind "machinegun" "use Machinegun"
    bind "chaingun" "use Chaingun"
    bind "grenade launcher" "use Grenade Launcher"
    bind "rocket launcher" "use Rocket Launcher"
    bind "hyperblaster" "use HyperBlaster"
    bind "railgun" "use Railgun"
    bind "bfg10k" "use BFG10K"
    bind "grenades" "use Grenades"
end
